# Local dev only. Copy to .env and fill in real values for `wrangler dev`.
# In the Cloudflare dashboard, set these on the Worker under
# Settings -> Variables and Secrets (mark secrets accordingly).
# Never commit the real .env file.

# Stripe (Dashboard -> Developers -> API keys / Webhooks / Product catalog)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOCIAL=price_...

# Cloudflare Registrar API (beta) — Dashboard -> Manage Account -> API Tokens,
# create a token with "Registrar Write" permission for your account.
CF_REGISTRAR_ACCOUNT_ID=...
CF_REGISTRAR_API_TOKEN=...

# Percentage added on top of Cloudflare's at-cost registration price
# before quoting the client (e.g. 30 = charge 30% over cost).
DOMAIN_MARKUP_PERCENT=30

# Existing Google Apps Script web app URL (see scripts/Code.gs) — reused
# to notify you by email on successful Stripe payments/registrations.
FORM_NOTIFY_ENDPOINT=https://script.google.com/macros/s/.../exec
